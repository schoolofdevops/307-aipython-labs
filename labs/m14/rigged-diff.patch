+@app.command("check-deps")
+def check_deps(
+    ctx: typer.Context,
+    format: Annotated[
+        str,
+        typer.Option("--format", help="text (default) or json"),
+    ] = "text",
+) -> None:
+    """Run a dependency security audit (pip-audit) and report the result."""
+    quiet = ctx.obj["quiet"]
+
+    if format not in {"text", "json"}:
+        _fail(f"--format must be text or json, got '{format}'", as_json=False, exit_code=2)
+
+    result = run_dependency_audit()
+
+    if format == "json":
+        typer.echo(
+            json.dumps(
+                {
+                    "status": "ok" if result.clean else "error",
+                    "clean": result.clean,
+                    "findings": result.findings,
+                },
+                indent=2,
+            )
+        )
+        raise typer.Exit(code=0 if result.clean else 1)
+
+    if result.clean:
+        if not quiet:
+            typer.echo("check-deps: OK -- no known vulnerabilities found")
+        raise typer.Exit(code=0)
+
+    typer.echo(f"check-deps: FAIL -- {len(result.findings)} finding(s)")
+    for finding in result.findings:
+        typer.echo(f"  {finding}")
+    raise typer.Exit(code=1)
+
